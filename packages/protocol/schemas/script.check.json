{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.engine/schemas/script.check.json",
  "title": "ScriptCheck",
  "description": "TypeScript type check and diagnostics reporting for script projects",
  "definitions": {
    "ScriptDiagnostic": {
      "type": "object",
      "required": ["file", "line", "column", "code", "message", "severity"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "column": { "type": "integer" },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] }
      },
      "additionalProperties": false
    },
    "ScriptCheckParams": {
      "type": "object",
      "properties": {
        "project_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ScriptCheckResult": {
      "type": "object",
      "required": ["success", "diagnostics"],
      "properties": {
        "success": { "type": "boolean" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/definitions/ScriptDiagnostic" }
        }
      },
      "additionalProperties": false
    }
  }
}
