  "fonts": {
    "sans": "'Geist Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', ui-monospace, monospace"
  },
  "typography": {
    "size": {
      "xs": "11px",
      "sm": "12px",
      "base": "13px",
      "md": "14px",
      "lg": "16px",
      "xl": "20px"
    },
    "lineHeight": {
      "xs": "14px",
      "sm": "16px",
      "base": "18px",
      "md": "20px",
      "lg": "24px",
      "xl": "28px"
    },
    "weight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "controlHeight": {
    "compact": {
      "sm": "22px",
      "md": "26px",
      "lg": "30px"
    },
    "comfortable": {
      "sm": "26px",
      "md": "30px",
      "lg": "34px"
    }
  },
  "elevation": {
    "low": "0 1px 2px 0 rgba(0, 0, 0, 0.4)",
    "medium": "0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -2px rgba(0, 0, 0, 0.5)",
    "high": "0 10px 15px -3px rgba(0, 0, 0, 0.6), 0 4px 6px -4px rgba(0, 0, 0, 0.6)",
    "floating": "0 20px 25px -5px rgba(0, 0, 0, 0.7), 0 8px 10px -6px rgba(0, 0, 0, 0.7)"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "normal": "150ms",
      "slow": "200ms"
    },
    "easing": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "zIndex": {
    "base": 0,
    "panel": 10,
    "header": 20,
    "dropdown": 50,
    "sticky": 60,
    "overlay": 100,
    "modal": 200,
    "popover": 300,
    "toast": 400,
    "tooltip": 500
  }
