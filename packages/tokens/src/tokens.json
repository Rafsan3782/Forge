{
  "theme": "dark",
  "colors": {
    "bg": {
      "base": "#0A0B0D",
      "panel": "#121418",
      "surface": "#181B20",
      "elevated": "#20232B",
      "active": "#282C36",
      "hover": "#1C1E24"
    },
    "border": {
      "base": "#23262D",
      "subtle": "#1A1C22",
      "focus": "#7C5CFF"
    },
    "text": {
      "primary": "#E8EAED",
      "muted": "#8B919C",
      "disabled": "#565B64",
      "inverse": "#0A0B0D"
    },
    "accent": {
      "ember": "#FF6A2B",
      "emberHover": "#E05A20",
      "arc": "#7C5CFF",
      "arcHover": "#6A4BE0"
    },
    "feedback": {
      "success": "#3DD68C",
      "warn": "#F5A524",
      "error": "#FF4D4F"
    }
  },
  "fonts": {
    "sans": "'Geist Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', monospace"
  },
  "spacing": {
    "0": "0px",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "normal": "160ms",
      "slow": "200ms"
    },
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
