{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@forge/ui": ["../../packages/ui/src/index.ts"],
      "@forge/tokens": ["../../packages/tokens/src/index.ts"],
      "@forge/tokens/*": ["../../packages/tokens/*"]
    }
  },
  "include": ["src"]
}
