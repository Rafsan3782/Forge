{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "codegen": "pnpm --filter @forge/protocol codegen",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm --filter studio build",
    "docs:build": "node --experimental-strip-types tools/docgen/build.ts",
    "docs:validate": "node --experimental-strip-types tools/docgen/validate.ts",
    "docs:test": "node --experimental-strip-types --test tools/docgen/tests/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "packageManager": "pnpm@12.8.1"
}
